<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewDesign.NewFragments.OutstandingFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/totalAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/_5dp"
        android:layout_marginStart="@dimen/_5dp"
        android:layout_marginEnd="@dimen/_5dp"
        app:cardCornerRadius="@dimen/_5dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeadingTotalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:padding="@dimen/_5dp"
                android:text="@string/total_amount"
                android:textColor="@color/black"
                android:textSize="@dimen/_20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeadingOutStanding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:padding="@dimen/_5dp"
                android:text="@string/_inr_250000"
                android:textColor="@color/red"
                android:textSize="@dimen/_20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:padding="@dimen/_5dp"
                android:text="@string/as_on_23_sep_2021"
                android:textColor="@color/reconGrey"
                android:textSize="@dimen/_15sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/accountNameList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30dp"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:layout_marginEnd="@dimen/_20dp"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_3dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_1dp"
                        app:cardCornerRadius="@dimen/_5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/searchBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:inputType="text"
                                android:background="@color/white"
                                android:hint="@string/search_area"
                                android:maxLines="1"
                                android:padding="@dimen/_10dp"
                                android:textSize="@dimen/_15sp" />

                            <ImageView
                                android:id="@+id/searchButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10dp"
                                android:padding="@dimen/_10dp"
                                android:src="@drawable/ic_vector" />


                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvAllGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/accountNameList"

                    android:layout_marginStart="@dimen/_15dp"
                    android:text="@string/all_group" />

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15dp"
                    android:layout_marginTop="@dimen/_10dp"

                    android:text="@string/search" />
                <androidx.cardview.widget.CardView
                    android:id="@+id/customerTypeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:layout_below="@+id/tvAllGroup"
                    android:layout_marginEnd="@dimen/_20dp"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_3dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_1dp"
                        app:cardCornerRadius="@dimen/_5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/customerTypeSearch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@color/white"
                                android:hint="@string/sundry_debtors"
                                android:maxLines="1"
                                android:padding="@dimen/_10dp"
                                android:textSize="@dimen/_15sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>

            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listOfData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/totalAmount"
        android:layout_marginStart="@dimen/_25dp"
        android:layout_marginTop="@dimen/_minus100dp"
        android:layout_marginEnd="@dimen/_25dp"
        android:elevation="@dimen/_10dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/outletRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/totalAmount"
        android:orientation="vertical" />


</RelativeLayout>