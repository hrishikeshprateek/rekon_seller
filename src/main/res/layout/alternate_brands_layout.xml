<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
android:id="@+id/constraintLayoutBrands"
    android:background="@color/gray92"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16dp"
        android:background="@color/white"
        android:layout_margin="@dimen/_1dp"
        app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:id="@+id/nameLayout"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content">
    <TextView
        android:id="@+id/productName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:padding="@dimen/_2dp"
        android:textColor="@color/colorBlack"
        android:textSize="@dimen/_16sp" />
    </LinearLayout>

   <LinearLayout
       android:id="@+id/rate_ll"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@+id/nameLayout">

       <TextView
           android:id="@+id/productPacking"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:padding="@dimen/_5dp"
           android:layout_weight="1"
           android:textColor="@color/colorBlack"
           android:textSize="@dimen/_16sp"

           />
       <TextView
           android:id="@+id/productPrice"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:padding="@dimen/_2dp"
           android:textColor="@color/colorBlack"
           android:textSize="@dimen/_16sp" />
   </LinearLayout>

    <TextView
        android:id="@+id/productBrandName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/_100dp"
        android:layout_marginTop="@dimen/_2dp"
        android:fontFamily="@font/montserrat_bold"
        android:padding="@dimen/_2dp"
        android:textColor="@color/new_grey"
        android:textSize="@dimen/_13sp"
        app:layout_constraintTop_toBottomOf="@+id/rate_ll"
        app:layout_constraintLeft_toLeftOf="@+id/productMrp"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/productMrp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/_2dp"
        android:layout_alignParentEnd="true"
        android:textColor="@color/red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="@+id/productBrandName"
        app:layout_constraintTop_toBottomOf="@id/rate_ll"
        android:textSize="@dimen/_16sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>