<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_10dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginEnd="@dimen/_10dp"
    app:cardCornerRadius="@dimen/_5dp"
    app:cardElevation="@dimen/_5dp"
    app:cardUseCompatPadding="true">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_15dp"
        android:layout_marginEnd="@dimen/_15dp"
        android:paddingTop="@dimen/_20dp"
        android:paddingBottom="@dimen/_20dp">

        <View
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/gray92"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/productAmount"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:padding="@dimen/_5dp"
            android:text="1*15"
            android:background="@color/gray92"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/_13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productName" />

        <View
            android:id="@+id/productDiscount"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productName" />

        <View
            android:id="@+id/separatorView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1dp"
            android:background="@color/gray92"
            app:layout_constraintTop_toBottomOf="@+id/productAmount" />

        <View
            android:id="@+id/productCompanyName"
            android:layout_width="@dimen/_100dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separatorView" />

        <View
            android:id="@+id/productSpecifiedName"
            android:layout_width="@dimen/_100dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productCompanyName" />

        <View
            android:id="@+id/tvPrice"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_20dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productSpecifiedName" />

        <View
            android:id="@+id/tvDiscount"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_20dp"
            android:background="@color/gray92"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productSpecifiedName" />

        <View
            android:id="@+id/tvMRP"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_20dp"
            android:background="@color/gray92"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productSpecifiedName" />

        <View
            android:id="@+id/tvPriceValue"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPrice" />

        <View
            android:id="@+id/tvDiscountValue"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDiscount" />

        <View
            android:id="@+id/tvMRPValue"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMRP" />

        <View
            android:id="@+id/tvInclusiveGST"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_30dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPriceValue" />

        <LinearLayout
            android:id="@+id/button_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:background="@color/gray92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInclusiveGST"

            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cardHolderSalt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/gray92"
                app:cardCornerRadius="@dimen/_5dp"
                app:cardElevation="@dimen/_3dp"
                app:cardUseCompatPadding="true">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_1dp"
                    app:cardBackgroundColor="@color/gray92"
                    app:cardCornerRadius="@dimen/_5dp">

                    <View
                        android:id="@+id/tv_salt"
                        android:layout_width="@dimen/_50dp"
                        android:layout_height="@dimen/_25dp" />

                    <View
                        android:id="@+id/textView"
                        android:layout_width="@dimen/_50dp"
                        android:layout_height="@dimen/_24dp"
                        android:background="@color/gray92" />
                </androidx.cardview.widget.CardView>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStockIn"
                android:layout_width="match_parent"
                app:cardBackgroundColor="@color/gray92"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/_5dp"
                app:cardElevation="@dimen/_3dp"
                app:cardUseCompatPadding="true">

                <View
                    android:id="@+id/tvStockIn"
                    android:layout_width="@dimen/_50dp"
                    android:layout_height="@dimen/_25dp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button_holder">

            <View
                android:id="@+id/minus_icon"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:background="@drawable/circle_background"
                android:padding="@dimen/_5dp"
                android:src="@drawable/minus" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30dp"
                android:paddingStart="@dimen/_20dp"
                android:paddingEnd="@dimen/_20dp">

                <View
                    android:id="@+id/item_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                    android:drawablePadding="@dimen/_20dp"
                    android:paddingStart="@dimen/_5dp"
                    android:text="1"
                    android:textSize="@dimen/_20sp" />
            </LinearLayout>

            <View
                android:id="@+id/plus_icon"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:background="@drawable/circle_background"
                android:padding="@dimen/_5dp"
                android:src="@drawable/plus"
                app:tint="@color/new_red" />


        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAddToCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/gray92"
            app:cardCornerRadius="@dimen/_5dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button_holder">

            <View
                android:id="@+id/addToCart"
                android:layout_width="@dimen/_50dp"
                android:layout_height="@dimen/_40dp" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>