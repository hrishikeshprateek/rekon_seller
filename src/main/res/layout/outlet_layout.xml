<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5dp"
        android:layout_marginEnd="@dimen/_5dp"
        app:cardCornerRadius="@dimen/_5dp"
        app:cardElevation="@dimen/_5dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_15dp"
            android:layout_marginEnd="@dimen/_15dp"
            android:paddingTop="@dimen/_20dp"
            android:paddingBottom="@dimen/_20dp">

            <TextView
                android:id="@+id/firmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_5dp"
                android:text="@string/calpol_500mg_capital"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_20sp"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_3dp"
                android:layout_marginStart="@dimen/_2dp"
                android:text="@string/glaxoSmithKine"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firmName" />

            <TextView
                android:id="@+id/customerType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_3dp"
                android:layout_marginStart="@dimen/_2dp"
                android:text="@string/calpolPlain"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress" />

            <TextView
                android:id="@+id/tvLastPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_3dp"
                android:layout_marginStart="@dimen/_2dp"
                android:text="@string/calpolPlain"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/customerType" />
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginEnd="@dimen/_20dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="@dimen/_5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress"
                app:cardElevation="@dimen/_3dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_1dp"
                    app:cardCornerRadius="@dimen/_5dp">



               <TextView
                   android:id="@+id/outstandingBalance"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:padding="@dimen/_5dp"
                   android:paddingStart="@dimen/_10dp"
                   android:paddingEnd="@dimen/_10dp"
                   android:text="@string/_inr_250000"
                   android:textColor="@color/red"
                   android:textSize="@dimen/_20sp"
                   />
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>