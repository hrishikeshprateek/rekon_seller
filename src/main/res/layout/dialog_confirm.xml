<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        android:layout_height="match_parent"
        app:cardElevation="@dimen/_10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/dialogConfirm_tvTitle"
                    fontPath="@string/font_crimson_SemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/new_blue"
                    android:gravity="center"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingBottom="@dimen/_12dp"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="18sp" />


                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="@dimen/_14dp"
                    android:src="@drawable/ic_back_white"
                    android:visibility="gone" />
            </RelativeLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/menuCard"
                android:layout_width="120dp"
                android:layout_gravity="center"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/_20dp"
                app:cardCornerRadius="@dimen/_500dp"
                app:cardElevation="@dimen/_5dp"
                app:cardPreventCornerOverlap="true">

                <ImageView
                    android:id="@+id/dialogConfirm_imgIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_8dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />
            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/dialogConfirm_tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:gravity="center"
                android:paddingLeft="@dimen/_15dp"
                android:paddingRight="@dimen/_15dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/mobile_number_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20dp"
                android:layout_marginTop="@dimen/_22dp"
                android:layout_marginRight="@dimen/_20dp"
                android:layout_marginBottom="@dimen/_22dp"
                android:background="@drawable/shape_border_grey_light"
                android:gravity="start|center"
                android:orientation="horizontal"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/_12dp"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingBottom="@dimen/_12dp">

                    <TextView
                        android:id="@+id/country_code_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="@dimen/_15dp"
                            android:layout_height="@dimen/_15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_select" />
                        <com.hbb20.CountryCodePicker
                            android:id="@+id/ccp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            app:ccpDialog_backgroundColor="@color/white"
                            app:ccpDialog_textColor="@color/black"
                            tools:ignore="MissingClass" />
                    </FrameLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/fragmentRegister_edtMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:gravity="start|center"
                    android:hint="@string/enter_mobile"
                    android:inputType="number"
                    android:maxLength="10"
                    android:paddingLeft="@dimen/_5dp"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingRight="@dimen/_5dp"
                    android:paddingBottom="@dimen/_12dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/otp_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10dp"
                android:layout_marginTop="@dimen/_22dp"
                android:layout_marginRight="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_22dp"
                android:background="@drawable/shape_border_grey_light"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/ed_OTP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:gravity="center"
                    android:hint="Enter OTP"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingLeft="@dimen/_5dp"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingRight="@dimen/_5dp"
                    android:paddingBottom="@dimen/_12dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ResendOtpLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/sampleTime"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/resendbtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:enabled="false"
                    android:padding="@dimen/_5dp"
                    android:textColor="@color/new_blue"
                    android:text="@string/Resend" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/resetPassword_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10dp"
                android:layout_marginRight="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_42dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5dp"
                    android:gravity="start|center"
                    android:text="@string/enter_your_new_password_twice_to_confirm"
                    android:textColor="@color/grey"
                    android:textSize="16sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_22dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_7dp"
                        android:gravity="start|center"
                        android:text="@string/new_password"
                        android:textStyle="normal"
                        android:textColor="@color/colorBlack"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/fragmentRegister_edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/color_cursor"
                        android:gravity="start|center"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:maxLength="20"
                        android:paddingLeft="@dimen/_7dp"
                        android:paddingTop="@dimen/_5dp"
                        android:paddingRight="@dimen/_12dp"
                        android:paddingBottom="@dimen/_12dp"
                        android:singleLine="true"
                        android:textSize="16sp" />

                    <include layout="@layout/view_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_7dp"
                        android:gravity="start|center"
                        android:text="@string/confirm_password_"
                        android:textStyle="normal"
                        android:textColor="@color/colorBlack"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/fragmentRegister_edtConfirmPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/color_cursor"
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:hint="@string/confirm_password"
                        android:inputType="textPassword"
                        android:maxLength="20"
                        android:paddingLeft="@dimen/_7dp"
                        android:paddingTop="@dimen/_5dp"
                        android:paddingRight="@dimen/_12dp"
                        android:paddingBottom="@dimen/_12dp"
                        android:singleLine="true"
                        android:textSize="16sp" />

                    <include layout="@layout/view_line" />
                </LinearLayout>
            </LinearLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/_10dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/btn_color">

                            <TextView
                                android:id="@+id/dialogConfirm_tvConfirm"
                                fontPath="@string/font_bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="@dimen/_10dp"
                                android:text="@string/call"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/cancel_btn_ll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/dialogConfirm_tvCancel"
                                fontPath="@string/font_bold"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="@dimen/_10dp"
                                android:text="@string/Cancel"
                                android:textAllCaps="true"
                                android:textColor="@color/warm_grey"
                                android:textSize="16sp" />


                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="@dimen/_1dp"
                            android:layout_height="match_parent"
                            android:background="@color/pinkish_grey" />


                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
