<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!--
        <include layout="@layout/actionbar_base_dark" />
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/search_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_5dp"
                app:cardElevation="@dimen/_5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/firmNameHolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginTop="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/_5dp"
                        app:cardElevation="@dimen/_5dp"
                        app:cardUseCompatPadding="true">

                        <TextView
                            android:id="@+id/firmName"
                            style="@style/PartyDetailsListingStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10dp"
                            android:text="@string/bhavisya_medical_store_pvt_ltd"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_20sp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>

                    <include
                        android:id="@+id/searchBar"
                        layout="@layout/search_bar_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_5dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvApplyFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dark_blue1"
                app:cardCornerRadius="@dimen/_5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:paddingStart="@dimen/_10dp"
                        android:paddingTop="@dimen/_10dp"
                        android:paddingEnd="@dimen/_10dp"
                        android:paddingBottom="@dimen/_10dp"
                        android:text="Filter"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13sp" />

                    <LinearLayout
                        android:id="@+id/llFilterCircle"
                        android:layout_width="@dimen/_10dp"
                        android:layout_height="@dimen/_10dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="@dimen/_10dp"
                        android:background="@drawable/bg_ci_redrcle"
                        android:orientation="horizontal"
                        android:visibility="gone"></LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/fragmentProfile_llContainerSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/_14dp"
            android:paddingRight="@dimen/_14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort by"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_4dp"
                android:background="@drawable/shape_dots_line"
                android:layerType="software"
                android:rotation="90" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/fragmentMyVendor_frmSortVendor"
                android:layout_width="@dimen/_170dp"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_5dp"
                android:paddingBottom="@dimen/_5dp">

                <TextView
                    android:id="@+id/fragmentMyVendor_tvCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_19dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/fragmentMyVendor_imgSortVendors"
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_30dp"
                    android:src="@drawable/down_arrow_hide" />
            </LinearLayout>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/pullToRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_party_listing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible" />
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/noRecordTV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/_150dp"
            android:gravity="center"
            android:text="@string/noRecordFound"
            android:textSize="@dimen/_20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>