<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".NewDesign.NewFragments.DeliveryDetails">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/deliveryLocationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="@dimen/_5dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/deliverHeading"
                        style="@style/MontserratBoldFontSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="@dimen/_10dp"
                        android:paddingBottom="@dimen/_10dp"
                        android:text="@string/deliver_to_your_location"
                        android:textSize="@dimen/_20sp"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/separatorView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@color/divider_line_grey"
                        app:layout_constraintTop_toBottomOf="@+id/deliverHeading" />

                    <RadioButton
                        android:id="@+id/radioDefaultAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_10dp"
                        android:buttonTint="@color/red"
                        android:checked="true"
                        android:text="@string/default_address"
                        app:layout_constraintTop_toBottomOf="@+id/separatorView" />

                    <TextView
                        android:id="@+id/tvDefaultUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_50dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:text="@string/default_address2"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/radioDefaultAddress" />


                    <TextView
                        android:id="@+id/tvDefaultAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_50dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:text="@string/default_address2"
                        app:layout_constraintTop_toBottomOf="@+id/tvDefaultUserName" />

                    <TextView
                        android:id="@+id/tvContactNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_50dp"
                        android:paddingBottom="@dimen/_20dp"
                        android:text="@string/contact_number"
                        app:layout_constraintTop_toBottomOf="@+id/tvDefaultAddress" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPickupStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="@dimen/_5dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toBottomOf="@id/deliveryLocationCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cvStoreAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/pickupHeading"
                        style="@style/MontserratBoldFontSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="@dimen/_10dp"
                        android:text="@string/pickup_from_store"
                        android:textSize="@dimen/_20sp"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/separatorView2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@color/divider_line_grey"
                        app:layout_constraintTop_toBottomOf="@+id/pickupHeading" />

                    <RadioButton
                        android:id="@+id/radioStoreAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10dp"
                        android:buttonTint="@color/red"
                        android:checked="false"
                        android:text="@string/store_address"
                        app:layout_constraintTop_toBottomOf="@+id/separatorView2" />

                    <TextView
                        android:id="@+id/tvStoreName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/radioStoreAddress" />

                    <TextView
                        android:id="@+id/tvStoreAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoreName" />

                    <TextView
                        android:id="@+id/tvStoreAddress2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress" />

                    <TextView
                        android:id="@+id/tvStoreAddress3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress2" />

                    <TextView
                        android:id="@+id/tvStorePinCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress3" />
                    <TextView
                        android:id="@+id/tvContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_30dp"
                        android:text="@string/contact_number_store"
                        app:layout_constraintTop_toBottomOf="@+id/tvStorePinCode" />
                    <TextView
                        android:id="@+id/tvStoreContactNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_30dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvContact" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/selectDateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="@dimen/_5dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toBottomOf="@+id/cardPickupStore">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MontserratBoldFontSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="@dimen/_8dp"
                        android:text="@string/select_delivery_date"
                        android:textSize="@dimen/_20sp" />

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"
                        android:layout_marginBottom="@dimen/_20dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <include
                android:id="@+id/paymentDetailCardIncluder"
                layout="@layout/payment_details_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/selectDateCard" />

            <androidx.cardview.widget.CardView
                android:id="@+id/commentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="@dimen/_5dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toBottomOf="@+id/paymentDetailCardIncluder">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MontserratBoldFontSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_50dp"
                        android:layout_marginEnd="@dimen/_50dp"
                        android:gravity="center"
                        android:paddingTop="@dimen/_10dp"
                        android:paddingBottom="@dimen/_10dp"
                        android:text="@string/comments"
                        android:textSize="@dimen/_20sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/coloredCardView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:layout_marginBottom="@dimen/_20dp"
                        app:cardBackgroundColor="@color/red">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_1dp">

                            <EditText
                                android:id="@+id/etComment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="top|left"
                                android:hint="@string/add_your_comment_here"
                                android:inputType="textMultiLine"
                                android:maxLines="6"
                                android:minLines="4"
                                android:paddingStart="@dimen/_20dp"
                                android:paddingTop="@dimen/_10dp"
                                android:scrollbars="vertical" />
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@+id/commentSection">

        <androidx.cardview.widget.CardView
            android:id="@+id/proceedSubmitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20dp"
            app:cardBackgroundColor="@color/red"
            app:cardCornerRadius="@dimen/_5dp"
            app:cardElevation="@dimen/_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/proceedToPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:paddingStart="@dimen/_40dp"
                android:paddingTop="@dimen/_10dp"
                android:paddingEnd="@dimen/_40dp"
                android:paddingBottom="@dimen/_10dp"
                android:text="@string/proceed_to_submit"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sp" />
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>