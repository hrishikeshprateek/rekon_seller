<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayoutNewOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAddProduct"
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_5dp"
        app:cardElevation="@dimen/_5dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_16dp">

            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_2dp"
                android:text="@string/calpol_500mg_capital"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_16sp"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvProductPacking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5dp"
                android:text="1*15"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productName" />

            <TextView
                android:id="@+id/tvProductScheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5dp"
                android:text="10+1"
                android:textColor="@color/green"
                android:textSize="@dimen/_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productName" />

            <View
                android:id="@+id/separatorView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1dp"
                android:background="@color/colorBlack"
                app:layout_constraintTop_toBottomOf="@+id/tvProductPacking" />

            <TextView
                android:id="@+id/productCompanyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:fontFamily="@font/montserrat_bold"
                android:padding="@dimen/_2dp"
                android:text="@string/glaxoSmithKine"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separatorView" />

            <TextView
                android:id="@+id/productSalt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:padding="@dimen/_2dp"
                android:text="@string/calpolPlain"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productCompanyName" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:padding="@dimen/_2dp"
                android:text="@string/price"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productSalt" />

            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/discount"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@+id/tvMRP"
                app:layout_constraintStart_toEndOf="@+id/tvPrice"
                app:layout_constraintTop_toBottomOf="@+id/productSalt" />

            <TextView
                android:id="@+id/tvMRP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"

                android:padding="@dimen/_2dp"
                android:paddingEnd="@dimen/_5dp"
                android:text="@string/mrp"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productSalt" />

            <TextView
                android:id="@+id/tvRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_2dp"
                android:text="@string/Rs11"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPrice" />

            <TextView
                android:id="@+id/tvDiscountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:padding="@dimen/_5dp"
                android:text="@string/percent7"
                android:textColor="@color/green"
                android:textSize="@dimen/_16sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDiscount" />

            <TextView
                android:id="@+id/tvMRPValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1dp"
                android:padding="@dimen/_2dp"
                android:text="@string/Rs15"
                android:textColor="@color/red"
                android:textSize="@dimen/_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMRP" />

            <TextView
                android:id="@+id/tvInclusiveGST"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:fontFamily="@font/montserrat_regular"
                android:padding="@dimen/_2dp"
                android:text="@string/inclusiveGst"
                android:textColor="@color/new_grey"
                android:textSize="@dimen/_12sp"
                app:layout_constraintStart_toEndOf="@+id/tvRate"
                app:layout_constraintTop_toBottomOf="@+id/tvMRP" />

            <LinearLayout
                android:id="@+id/button_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvInclusiveGST">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHolderSalt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/grey"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_3dp"
                    app:cardUseCompatPadding="true">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/white"
                        android:layout_margin="@dimen/_1dp"
                        app:cardCornerRadius="@dimen/_5dp">

                        <TextView
                            android:id="@+id/tv_salt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingTop="@dimen/_5dp"
                            android:paddingBottom="@dimen/_5dp"
                            android:text="@string/NRX_H1"
                            android:textSize="@dimen/_13sp" />
                    </androidx.cardview.widget.CardView>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStockIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/green"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_3dp"
                    app:cardUseCompatPadding="true">

                    <TextView
                        android:id="@+id/tvStockIn1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:paddingTop="@dimen/_6dp"
                        android:paddingBottom="@dimen/_6dp"
                        android:text="@string/StockIn"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>


            <RelativeLayout
                android:id="@+id/addToCartRl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                app:layout_constraintTop_toBottomOf="@+id/tvInclusiveGST">

                <TextView
                    android:id="@+id/tvStockIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_5dp"
                    android:padding="@dimen/_5dp"
                    android:text="@string/StockIn"
                    android:textSize="@dimen/_16sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:id="@+id/llQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/_5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/minus_icon"
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:background="@drawable/circle_background"
                        android:padding="@dimen/_5dp"
                        android:src="@drawable/minus" />

                    <LinearLayout
                        android:id="@+id/itemNumberLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40dp">

                        <EditText
                            android:id="@+id/item_number"
                            android:layout_width="@dimen/_60dp"
                            android:layout_height="@dimen/_60dp"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                            android:drawablePadding="@dimen/_5dp"
                            android:gravity="center"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="4"
                            android:minWidth="@dimen/_20dp"
                            android:textSize="@dimen/_20sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/plus_icon"
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:background="@drawable/circle_background"
                        android:padding="@dimen/_5dp"
                        android:src="@drawable/plus"
                        app:tint="@color/new_red" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/addEnteredValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8dp"
                        app:cardBackgroundColor="@color/dark_blue1"
                        app:cardCornerRadius="@dimen/_5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_5dp"
                            android:paddingStart="@dimen/_15dp"
                            android:paddingEnd="@dimen/_15dp"
                            android:text="@string/add"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvAddToCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:visibility="visible"
                    app:cardBackgroundColor="@color/dark_blue1"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/addToCart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:paddingStart="@dimen/_20dp"
                        android:paddingTop="@dimen/_10dp"
                        android:paddingEnd="@dimen/_20dp"
                        android:paddingBottom="@dimen/_10dp"
                        android:text="@string/addToCart"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13sp" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <View
                android:id="@+id/separatorViewLine"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2dp"
                android:background="@color/reconGrey"
                app:layout_constraintTop_toBottomOf="@+id/addToCartRl" />

            <TextView
                android:id="@+id/tvSeeSimilar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/_5dp"
                android:text="@string/see_similar_products"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/separatorViewLine" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/productAndScheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/separatorViewLine">

                <LinearLayout
                    android:id="@+id/productValueLL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_10dp"
                    app:layout_constraintEnd_toStartOf="@+id/schemeValueLL"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:text="@string/product_value"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/schemeValueTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schemes"
                        android:textColor="@color/green" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/schemeValueLL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/productValueTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:text="₹0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_16sp" />

                    <TextView
                        android:id="@+id/schemeValueTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>