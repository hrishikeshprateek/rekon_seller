<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".NewDesign.NewFragments.OrderHistory">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/recordsUI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/selectFirmCv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_marginEnd="@dimen/_8dp"
                    android:layout_marginBottom="@dimen/_5dp"
                    android:visibility="visible"
                    app:cardBackgroundColor="@color/new_blue"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_1dp"
                        app:cardCornerRadius="@dimen/_5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_margin="@dimen/_2dp"
                            android:background="@color/white"
                            android:orientation="horizontal"
                            android:padding="@dimen/_5dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_20dp"
                                    android:layout_height="@dimen/_20dp"
                                    android:src="@drawable/user_ic"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvFirmName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_2dp"
                                    android:layout_weight="2"
                                    android:fontFamily="@font/montserrat_regular"
                                    android:gravity="start|center"
                                    android:text="@string/select_your_firm"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="@dimen/_25dp"
                                    android:layout_height="@dimen/_25dp"
                                    android:src="@drawable/ic_baseline_arrow_drop_down_24" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivClearFirm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:paddingStart="@dimen/_10dp"
                                android:paddingEnd="@dimen/_10dp"
                                android:src="@drawable/ic_clear_black_24dp"
                                android:visibility="gone" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="2">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/new_blue"
                            app:cardCornerRadius="@dimen/_5dp"
                            app:cardElevation="@dimen/_5dp"
                            app:cardUseCompatPadding="true">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start|center"
                                android:layout_margin="@dimen/_1dp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_5dp"
                                app:cardCornerRadius="@dimen/_5dp">


                                <LinearLayout
                                    android:id="@+id/parent_cv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/_5dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="2"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvAccountName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="@dimen/_5dp"
                                            android:fontFamily="@font/montserrat_regular"
                                            android:gravity="start|center"
                                            android:text="@string/selectParty"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/_14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvAddress"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="@dimen/_5dp"
                                            android:fontFamily="@font/roboto_regular"
                                            android:textColor="@color/reconGrey"
                                            android:textSize="@dimen/_12sp"
                                            android:visibility="gone"
                                            app:layout_constraintTop_toBottomOf="@+id/tvAccountName" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="@dimen/_25dp"
                                        android:layout_height="@dimen/_25dp"
                                        android:src="@drawable/ic_baseline_arrow_drop_down_24" />

                                    <ImageView
                                        android:id="@+id/iv_clear_filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:paddingStart="@dimen/_10dp"
                                        android:paddingEnd="@dimen/_10dp"
                                        android:src="@drawable/ic_clear_black_24dp"
                                        android:visibility="gone" />

                                </LinearLayout>


                            </androidx.cardview.widget.CardView>

                        </androidx.cardview.widget.CardView>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/payModelCv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_5dp"
                        android:layout_weight="8"
                        android:background="@color/blue0"
                        android:gravity="end|center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPayMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:gravity="end"
                            android:hint="@string/mode"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sp" />

                        <ImageView
                            android:layout_width="@dimen/_25dp"
                            android:layout_height="@dimen/_25dp"
                            android:src="@drawable/ic_baseline_arrow_drop_down_24" />


                    </LinearLayout>


                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/orderHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/_5dp"
                    app:cardElevation="@dimen/_5dp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvAllOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center"
                                android:text="@string/all_orders"
                                android:textColor="@color/reconGrey"
                                android:textSize="@dimen/_15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/allCountTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_2dp"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center"
                                android:text="(0)"
                                android:textColor="@color/grey"
                                android:textSize="@dimen/_13sp"
                                android:visibility="gone" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvRecentOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_regular"
                                android:text="@string/recent_orders"
                                android:textColor="@color/red"
                                android:textSize="@dimen/_15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/recentCountTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_2dp"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center"
                                android:text="(0)"
                                android:textColor="@color/grey"
                                android:textSize="@dimen/_13sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvCanceledOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center"
                                android:text="@string/cancel_orders"
                                android:textColor="@color/reconGrey"
                                android:textSize="@dimen/_15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cancelledCountTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_2dp"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center"
                                android:text="(0)"
                                android:textColor="@color/grey"
                                android:textSize="@dimen/_13sp"
                                android:visibility="gone" />
                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:paddingTop="@dimen/_5dp"
                    android:paddingBottom="@dimen/_5dp"
                    android:textColor="@color/new_blue"
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/orderHistoryRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/noRecordTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_30dp"
                    android:gravity="center"
                    android:text="@string/noRecordFound" />

            </LinearLayout>


        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/taggedPaymentShowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_15dp"
            android:layout_marginTop="@dimen/_15dp"
            android:layout_marginEnd="@dimen/_85dp"
            android:layout_marginBottom="@dimen/_25dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/red"
            app:cardCornerRadius="@dimen/_5dp"
            app:cardElevation="@dimen/_5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTaggedPaymentTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:padding="@dimen/_10dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/open_calender_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_baseline_date_range_24"
            android:visibility="gone"
            app:backgroundTint="@color/pale_red"
            app:borderWidth="20dp"
            app:elevation="10dp"
            app:fabCustomSize="@dimen/_60dp"
            app:maxImageSize="@dimen/_30dp" />
    </RelativeLayout>

</LinearLayout>