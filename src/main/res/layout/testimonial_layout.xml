<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_300dp"

    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/_3dp"
        android:id="@+id/testimonialMainCard"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/testimonial_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:fontFamily="@font/montserrat_regular"
                android:padding="@dimen/_8dp"
                android:maxLines="3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/customerNameHolder"
                android:text="@string/test_text"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_14sp" />

            <LinearLayout
                android:id="@+id/customerNameHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8dp"
                app:layout_constraintTop_toBottomOf="@+id/testimonial_description"
                app:layout_constraintBottom_toTopOf="@+id/ratingHolder"
                android:paddingTop="@dimen/_8dp"
                android:paddingEnd="@dimen/_8dp">

                <TextView
                    android:id="@+id/author_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="start"
                    android:maxLines="1"

                    android:text="@string/Aman_Jain"
                    android:textColor="@color/new_grey"
                    android:textSize="@dimen/_14sp" />

                <TextView
                    android:id="@+id/writing_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="end"
                    android:text="@string/test_date"
                    android:textColor="@color/new_grey"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ratingHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8dp"
                android:paddingEnd="@dimen/_8dp"
                app:layout_constraintTop_toBottomOf="@+id/customerNameHolder"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingBottom="@dimen/_8dp">

                <TextView
                    android:id="@+id/author_organisation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="@string/ABC_Medical_Store"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/author_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_baseline_star_rate_24"
                    android:drawableTint="@color/new_pink"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="end"
                    android:text="@string/test_rating"
                    android:textColor="@color/new_grey"
                    android:textSize="@dimen/_15sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>