<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/_7dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/SelectImageLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginTop="@dimen/_6dp"
            android:layout_marginRight="9dp"
            app:cardElevation="@dimen/_5dp"
            app:cardBackgroundColor="@color/new_blue"
            app:cardCornerRadius="@dimen/_10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                app:cardCornerRadius="@dimen/_10dp"
                android:layout_margin="@dimen/_2dp"
                android:background="@color/white">
                <TextView
                    android:id="@+id/maxImageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_margin="@dimen/_10dp"
                    android:drawablePadding="@dimen/_10dp"
                    android:drawableTint="@color/denim_blue"
                    android:drawableTop="@drawable/ic_baseline_add_circle_24"
                    android:text="@string/you_can_select_upto"
                    android:textColor="@color/denim_blue"
                    android:visibility="visible" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_1dp"
                android:layout_marginTop="@dimen/_6dp"
                android:layout_marginRight="9dp"
                app:cardElevation="@dimen/_5dp"
                app:cardBackgroundColor="@color/denim_blue"
                app:cardCornerRadius="@dimen/_10dp">

                <ImageView
                    android:id="@+id/imgPhoto"
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/cross_img"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_20dp"
                android:drawableEnd="@drawable/ic_baseline_cancel_24"
                android:drawablePadding="@dimen/_5dp"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_gravity="center"
                android:text="@string/remove" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgGroupPhoto"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/ic_group_images"
        android:visibility="gone" />


</FrameLayout>