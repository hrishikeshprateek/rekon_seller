<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/Order_no_ll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35dp"
        android:layout_marginTop="-5dp"
        android:layout_marginBottom="@dimen/_2dp"
        android:background="@color/warm_grey"
        android:gravity="start|center"
        android:orientation="horizontal"
        android:padding="@dimen/_5dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".8"
                android:singleLine="true"
                android:text="Name: "
                android:textColor="@color/black"
                android:textSize="@dimen/_14dp" />

            <TextView
                android:id="@+id/party_name_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_14dp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Order_status_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_5dp"
        android:orientation="horizontal"
        android:background="@color/light_grey"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:padding="@dimen/_3dp"
            android:text="Address: "
            android:textColor="@color/slate_grey_two"
            android:textSize="@dimen/_14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight=".2"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/address_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_3dp"
                android:padding="@dimen/_3dp"
                android:text="COMPLETED"
                android:textColor="@color/black"
                android:textSize="@dimen/_14dp" />
            <LinearLayout
                android:id="@+id/add2_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/view_line" />

                <TextView
                    android:id="@+id/address_txt2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_3dp"
                    android:padding="@dimen/_3dp"
                    android:text="sdds"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/add3_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/view_line" />

                <TextView
                    android:id="@+id/address_txt3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_3dp"
                    android:padding="@dimen/_3dp"
                    android:text="dsdds"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/orderItem_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_grey"
        android:orientation="vertical"
        android:visibility="visible">


        <LinearLayout
            android:id="@+id/phone_row_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2dp"
            android:gravity="start|center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".8"
                android:padding="@dimen/_3dp"
                android:text="Mobile: "
                android:textColor="@color/slate_grey_two"
                android:textSize="@dimen/_14dp" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center"
                android:orientation="horizontal"
                android:layout_weight=".2">
                <LinearLayout
                    android:id="@+id/call_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/mobile_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_3dp"
                        android:padding="@dimen/_3dp"
                        android:text="1223444567"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="end"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/call_img"
                            android:layout_width="@dimen/_20dp"
                            android:layout_height="@dimen/_20dp"
                            android:layout_gravity="end"
                            android:src="@mipmap/mobile_icon" />
                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/gst_row_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".8"
                android:padding="@dimen/_5dp"
                android:text="GST No: "
                android:textColor="@color/slate_grey_two"
                android:textSize="@dimen/_13dp" />

            <TextView
                android:id="@+id/gst_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_3dp"
                android:layout_weight=".2"
                android:padding="@dimen/_3dp"
                android:text="123@gmail.com"
                android:textColor="@color/black"
                android:textSize="@dimen/_14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/email_row_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".8"
                android:padding="@dimen/_3dp"
                android:text="Email: "
                android:textColor="@color/slate_grey_two"
                android:textSize="@dimen/_13dp" />

            <TextView
                android:id="@+id/email_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_3dp"
                android:layout_weight=".2"
                android:padding="@dimen/_3dp"
                android:text="123@gmail.com"
                android:textColor="@color/black"
                android:textSize="@dimen/_14dp" />
        </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/_5dp"
    android:background="@color/white">

</LinearLayout>

    </LinearLayout>

</LinearLayout>
