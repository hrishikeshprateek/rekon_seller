                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/lr_no"
                                android:textSize="@dimen/_13sp" />

                            <TextView
                                android:id="@+id/tvLrNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/test_lr_no"
                                android:textSize="@dimen/_13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_2dp">


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/lr_date"
                                android:textSize="@dimen/_13sp" />

                            <TextView
                                android:id="@+id/tvLrDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/test_date"
                                android:textSize="@dimen/_13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/case_box"
                                android:textSize="@dimen/_13sp" />

                            <TextView
                                android:id="@+id/tvCase"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/_case4"
                                android:textSize="@dimen/_13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/eWayBillNo"
                                android:textSize="@dimen/_13sp" />

                            <TextView
                                android:id="@+id/tvEWayBillNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/test_Number"
                                android:textSize="@dimen/_13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/adjustDetailsLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1dp"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="@dimen/_5dp"
                    app:layout_constraintTop_toBottomOf="@+id/dispatchDetailsLL">

                    <TextView
                        android:id="@+id/tvAdjustDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5dp"
                        android:orientation="horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/adjustDetailsRv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="@dimen/_10dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_300dp"
            android:layout_height="@dimen/_200dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_trasaction_load">

        </ImageView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/loading"
            android:textColor="@color/black"
            android:textSize="@dimen/_20sp"
            android:textStyle="bold">

        </TextView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/noDataView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_300dp"
            android:layout_height="@dimen/_200dp"
            android:scaleType="centerInside"
            android:src="@drawable/iv_no_data">

        </ImageView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/noRecordFound"
            android:textColor="@color/black"
            android:textSize="@dimen/_20sp"
            android:textStyle="bold">

        </TextView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/shareSaleInvoiceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="5dp"
        app:cardElevation="@dimen/_3dp"
        android:visibility="visible"
        app:cardUseCompatPadding="true">


        <androidx.cardview.widget.CardView
            android:id="@+id/shareSaleInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10dp"
            android:visibility="visible"
            app:cardBackgroundColor="@color/red"
            app:cardCornerRadius="@dimen/_5dp"
            app:cardElevation="@dimen/_5dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:padding="@dimen/_10dp"
                android:text="@string/view_bill"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sp" />

        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</RelativeLayout>