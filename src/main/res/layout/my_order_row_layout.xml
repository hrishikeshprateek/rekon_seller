<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selection_img_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/order_agency_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_grey"
        android:paddingLeft="@dimen/_5dp"
        android:paddingTop="@dimen/_10dp"
        android:paddingRight="@dimen/_5dp"
        android:text="ORDER FIRM NAME"
        android:textColor="@color/black"
        android:textSize="@dimen/_12dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_5dp"
        android:background="@color/light_grey"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/order_details_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="@dimen/_5dp"
            android:layout_marginBottom="@dimen/_2dp"
            android:gravity="center|end"
            android:visibility="gone">

            <TextView
                android:id="@+id/view_details_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:padding="@dimen/_5dp"
                android:singleLine="true"
                android:text="Order Details"
                android:textColor="@color/dark_blue"
                android:textSize="@dimen/_12dp" />

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:layout_gravity="center|end"
                android:src="@mipmap/forward_icon_black" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Order_no_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_marginBottom="@dimen/_2dp"
        android:background="@color/grey"
        android:gravity="start|center"
        android:orientation="horizontal"
        android:padding="@dimen/_5dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="ORDER NO: "
                android:textColor="@color/white"
                android:textSize="@dimen/_14dp" />

            <TextView
                android:id="@+id/order_number_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="123456-12345-1234567890"
                android:textColor="@color/white"
                android:textSize="@dimen/_14dp" />
        </LinearLayout>


        <TextView
            android:id="@+id/product_date_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10dp"
            android:layout_weight="1"
            android:padding="@dimen/_5dp"
            android:text="Date"
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@color/white"
            android:textSize="@dimen/_14dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Order_status_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5dp"
        android:layout_marginBottom="@dimen/_10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="@dimen/_3dp"
            android:text="Order Execution Status: "
            android:textColor="@color/black"
            android:textSize="@dimen/_14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight="1"
            android:gravity="end">

            <TextView
                android:id="@+id/status_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_3dp"
                android:gravity="end"
                android:padding="@dimen/_3dp"
                android:text="COMPLETED"
                android:textColor="@color/green"
                android:textSize="@dimen/_14dp" />
        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_my_order_listing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20dp"
        android:layout_marginTop="@dimen/_2dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:visibility="gone">

    </androidx.recyclerview.widget.RecyclerView>

    <LinearLayout
        android:id="@+id/orderItem_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_grey"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/product_name_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5dp"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="@dimen/_14dp" />
        <TextView
            android:id="@+id/product_Pack_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:padding="@dimen/_5dp"
            android:text="Pack: "
            android:textSize="@dimen/_13dp" />
        <TextView
            android:id="@+id/order_qty_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5dp"
            android:textColor="@color/black"
            android:text="Order QTY: "
            android:textSize="@dimen/_13dp" />

        <TextView
            android:id="@+id/product_Del_txt"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5dp"
            android:text="Delivered QTY: "
            android:textSize="@dimen/_13dp" />

    </LinearLayout>

</LinearLayout>
