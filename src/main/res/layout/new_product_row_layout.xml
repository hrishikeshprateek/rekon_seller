<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayoutNewOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_5dp"
        app:cardElevation="@dimen/_5dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/_10dp"
                android:paddingTop="@dimen/_8dp"
                android:paddingEnd="@dimen/_1dp"
                android:paddingBottom="@dimen/_2dp"
                android:weightSum="10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="3.5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProductRefId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/new_grey"
                        android:textSize="@dimen/_15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/productName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="@string/calpol_500mg_capital"
                            android:textColor="@color/title_color_primary"
                            android:textSize="@dimen/_15sp" />

                        <TextView
                            android:id="@+id/tvProductPacking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_regular"
                            android:paddingLeft="@dimen/_5dp"
                            android:text="1*15"
                            android:textColor="@color/title_color_primary"
                            android:textSize="@dimen/_13sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/productCompanyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="@string/glaxoSmithKine"
                        android:textColor="@color/new_grey"
                        android:textSize="@dimen/_13sp" />
                    <TextView
                        android:id="@+id/productSaltTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2dp"
                        android:layout_marginBottom="@dimen/_2dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/new_grey"
                        android:textSize="@dimen/_13sp" />
                    <TextView
                        android:id="@+id/iGroupTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2dp"
                        android:layout_marginBottom="@dimen/_2dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/new_grey"
                        android:textSize="@dimen/_13sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="@string/Rs11"
                            android:textColor="@color/title_color_primary"
                            android:textSize="@dimen/_14sp" />

                        <TextView
                            android:id="@+id/tvMRPValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5dp"
                            android:layout_marginRight="@dimen/_3dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/Rs15"
                            android:textColor="@color/new_grey"
                            android:textFontWeight="500"
                            android:textSize="@dimen/_14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvMRP" />

                        <TextView
                            android:id="@+id/tvGST"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GST 12%"
                            android:textColor="@color/new_blue"
                            android:textSize="@dimen/_11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/distributorRowLl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_1dp"
                        android:layout_marginEnd="@dimen/_2dp"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDistributorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="start|center"
                            android:textColor="@color/text_grey1"
                            android:textSize="12sp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/ratingCV"
                            android:layout_width="@dimen/_30dp"
                            android:layout_height="@dimen/_15dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/_5dp"
                            android:layout_marginTop="@dimen/_5dp"
                            android:layout_marginEnd="@dimen/_5dp"
                            android:layout_marginBottom="@dimen/_5dp"
                            android:visibility="visible"
                            app:cardBackgroundColor="@color/green"
                            app:cardCornerRadius="@dimen/_3dp"
                            app:cardElevation="@dimen/_0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/ratingTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:drawablePadding="5dp"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="9sp"
                                    android:textStyle="bold">

                                </TextView>

                                <ImageView
                                    android:layout_width="@dimen/_8dp"
                                    android:layout_height="@dimen/_8dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/white_star">

                                </ImageView>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>


                    </LinearLayout>

                    <TextView
                        android:id="@+id/activeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_5dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="start|center"
                        android:textColor="@color/green"
                        android:textSize="16sp"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="6.5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProductScheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sch 10+1F"
                        android:textColor="@color/green"
                        android:textFontWeight="600"
                        android:textSize="@dimen/_12sp"
                        android:visibility="visible" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvUpdateCartBtn"
                        android:layout_width="@dimen/_80dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_2dp"
                        android:layout_marginBottom="@dimen/_2dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/darkGreen"
                        app:cardCornerRadius="@dimen/_5dp"
                        app:cardUseCompatPadding="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingStart="@dimen/_10dp"
                            android:paddingTop="@dimen/_5dp"
                            android:paddingEnd="@dimen/_10dp"
                            android:paddingBottom="@dimen/_5dp"
                            android:text="@string/update"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvAddToCart"
                        android:layout_width="@dimen/_80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2dp"
                        android:layout_marginBottom="@dimen/_2dp"
                        android:visibility="visible"
                        app:cardBackgroundColor="@color/new_blue"
                        app:cardCornerRadius="@dimen/_5dp"
                        app:cardUseCompatPadding="true">

                        <TextView
                            android:id="@+id/addToCart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingStart="@dimen/_15dp"
                            android:paddingTop="@dimen/_5dp"
                            android:paddingEnd="@dimen/_15dp"
                            android:paddingBottom="@dimen/_5dp"
                            android:text="@string/add"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/addEnteredValue"
                        android:layout_width="@dimen/_80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2dp"
                        android:layout_marginBottom="@dimen/_2dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/new_blue"
                        app:cardCornerRadius="@dimen/_5dp"
                        app:cardUseCompatPadding="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingStart="@dimen/_15dp"
                            android:paddingTop="@dimen/_5dp"
                            android:paddingEnd="@dimen/_15dp"
                            android:paddingBottom="@dimen/_5dp"
                            android:text="@string/add"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sp" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvStockIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/available"
                        android:textColor="@color/darkGreen01"
                        android:textSize="@dimen/_13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/minus_icon"
                            android:layout_width="@dimen/_30dp"
                            android:layout_height="@dimen/_30dp"
                            android:src="@drawable/ic_minus" />


                        <EditText
                            android:id="@+id/item_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                            android:gravity="center"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="4"
                            android:minWidth="@dimen/_20dp"
                            android:paddingStart="@dimen/_10dp"
                            android:paddingRight="@dimen/_10dp"
                            android:textSize="@dimen/_20sp" />

                        <ImageView
                            android:id="@+id/plus_icon"
                            android:layout_width="@dimen/_30dp"
                            android:layout_height="@dimen/_30dp"
                            android:src="@drawable/ic_plus" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llNetValueRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_5dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="@string/QTY"
                                    android:textColor="@color/new_grey"
                                    android:textSize="@dimen/_13sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvAddedQty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/_5dp"
                                    android:gravity="end"
                                    android:textColor="@color/title_color_primary"
                                    android:textSize="@dimen/_16sp"
                                    android:textStyle="bold"
                                    android:visibility="visible" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/fQtyTvLL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:gravity="end"
                                android:orientation="horizontal"
                                android:visibility="visible">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FQty:"
                                    android:textColor="@color/new_grey"
                                    android:textSize="@dimen/_13sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvAddedFQty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5dp"
                                    android:gravity="end"
                                    android:textColor="@color/title_color_primary"
                                    android:textSize="@dimen/_16sp"
                                    android:textStyle="bold"
                                    android:visibility="visible" />

                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/netValueRowLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_2dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Net Value:"
                    android:textColor="@color/new_grey"
                    android:textSize="@dimen/_13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvNetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5dp"
                    android:textColor="@color/title_color_primary"
                    android:textSize="@dimen/_16sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>