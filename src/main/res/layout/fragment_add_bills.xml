<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewDesign.NewFragments.AddBillsFragment">
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginBottom="@dimen/_60dp"
       android:orientation="vertical">

       <androidx.cardview.widget.CardView
           android:id="@+id/adjustmentCv"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/white"
           android:layout_marginBottom="@dimen/_5dp"
           app:cardCornerRadius="1dp"
           app:cardElevation="@dimen/_5dp">

           <LinearLayout
               android:id="@+id/adjustmentLl"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginStart="@dimen/_10dp"
               android:layout_marginTop="@dimen/_10dp"
               android:layout_marginEnd="@dimen/_10dp"
               android:orientation="vertical">

               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:fontFamily="@font/montserrat_bold"
                   android:layout_marginBottom="@dimen/_5dp"
                   android:gravity="start"
                   android:text="@string/adjustment_details"
                   android:textColor="@color/reconGrey"
                   android:textSize="@dimen/_15sp" />

               <androidx.cardview.widget.CardView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="@dimen/_2dp"
                   android:layout_marginBottom="@dimen/_10dp"
                   app:cardBackgroundColor="@color/new_blue"
                   app:cardCornerRadius="@dimen/_5dp">

                   <androidx.cardview.widget.CardView
                       android:layout_width="match_parent"
                       app:cardBackgroundColor="@color/white"
                       android:layout_height="wrap_content"
                       android:layout_margin="1dp"
                       app:cardCornerRadius="@dimen/_5dp">

                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:background="@color/white"
                           android:orientation="vertical"
                           android:padding="@dimen/_5dp">

                           <LinearLayout
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_marginTop="@dimen/_2dp"
                               android:orientation="horizontal"
                               android:padding="@dimen/_2dp">

                               <TextView
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:fontFamily="@font/roboto_regular"
                                   android:gravity="start"
                                   android:textSize="@dimen/_14sp"
                                   android:text="@string/receipt_amount"
                                   android:textColor="@color/reconGrey" />

                               <TextView
                                   android:id="@+id/receiptAmtTv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:fontFamily="@font/montserrat_bold"
                                   android:gravity="end"
                                   android:text="0"
                                   android:textSize="@dimen/_15sp"
                                   android:textColor="@color/reconGrey" />
                           </LinearLayout>

                           <LinearLayout
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:orientation="horizontal"
                               android:paddingStart="@dimen/_2dp"
                               android:paddingEnd="@dimen/_2dp">

                               <TextView
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:gravity="start"
                                   android:text="@string/adjusted_amount"
                                   android:textSize="@dimen/_14sp" />

                               <TextView
                                   android:id="@+id/adjustedAmtTv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:gravity="end"
                                   android:text="0"
                                   android:textSize="@dimen/_15sp" />
                           </LinearLayout>

                           <LinearLayout
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_marginBottom="@dimen/_2dp"
                               android:orientation="horizontal"
                               android:paddingStart="@dimen/_2dp"
                               android:paddingEnd="@dimen/_2dp">

                               <TextView
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:gravity="start"
                                   android:text="@string/pending_amount"
                                   android:textSize="@dimen/_14sp" />

                               <TextView
                                   android:id="@+id/pendingAmtTv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_weight="1"
                                   android:gravity="end"
                                   android:text="0"
                                   android:textSize="@dimen/_15sp" />
                           </LinearLayout>

                       </LinearLayout>
                   </androidx.cardview.widget.CardView>
               </androidx.cardview.widget.CardView>

           </LinearLayout>

       </androidx.cardview.widget.CardView>

       <androidx.core.widget.NestedScrollView
           android:id="@+id/scrollView"
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="vertical">


               <androidx.cardview.widget.CardView
                   android:id="@+id/outletOverViewCard"
                   android:layout_width="match_parent"
                   app:cardBackgroundColor="@color/white"
                   android:layout_height="match_parent"
                   android:layout_marginTop="@dimen/_5dp"
                   app:cardCornerRadius="@dimen/_0dp"
                   app:cardElevation="@dimen/_5dp">

                   <androidx.constraintlayout.widget.ConstraintLayout
                       android:id="@+id/searchBarLayout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/_10dp"
                       android:layout_marginBottom="@dimen/_20dp">

                       <TextView
                           android:id="@+id/addBillsTv"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:layout_marginStart="@dimen/_10dp"
                           android:layout_marginBottom="@dimen/_10dp"
                           android:gravity="start"
                           android:text="@string/pending_bills"
                           android:textColor="@color/reconGrey"
                           android:textSize="@dimen/_14sp"
                           android:textStyle="bold"
                           app:layout_constraintTop_toTopOf="parent" />

                       <LinearLayout
                           android:id="@+id/actionLl"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:layout_marginTop="@dimen/_5dp"
                           android:orientation="horizontal"
                           app:layout_constraintTop_toBottomOf="@+id/addBillsTv">

                           <androidx.cardview.widget.CardView
                               android:id="@+id/autoAdjustCv"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_gravity="start"
                               android:layout_marginStart="@dimen/_10dp"
                               android:layout_marginTop="@dimen/_5dp"
                               android:layout_marginEnd="@dimen/_80dp"
                               android:layout_marginBottom="@dimen/_10dp"
                               android:layout_weight="1"
                               android:visibility="visible"
                               app:cardBackgroundColor="@color/green_reckon"
                               app:cardCornerRadius="@dimen/_5dp"
                               app:cardElevation="@dimen/_10dp">

                               <TextView
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:layout_gravity="center"
                                   android:fontFamily="@font/montserrat_regular"
                                   android:gravity="center"
                                   android:paddingTop="@dimen/_5dp"
                                   android:paddingBottom="@dimen/_5dp"
                                   android:text="@string/auto_adjust"
                                   android:textColor="@color/white"
                                   android:textSize="@dimen/_12sp"
                                   android:textStyle="bold" />

                           </androidx.cardview.widget.CardView>

                           <androidx.cardview.widget.CardView
                               android:id="@+id/clearAllCv"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_gravity="end"
                               android:layout_marginStart="@dimen/_80dp"
                               android:layout_marginTop="@dimen/_5dp"
                               android:layout_marginEnd="@dimen/_10dp"
                               android:layout_weight="1"
                               android:visibility="visible"

                               app:cardBackgroundColor="@color/new_blue"
                               app:cardCornerRadius="@dimen/_5dp"
                               app:cardElevation="@dimen/_10dp"
                               app:layout_constraintTop_toBottomOf="@+id/docAndDateHolderLL">

                               <TextView
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:layout_gravity="center"
                                   android:fontFamily="@font/montserrat_regular"
                                   android:gravity="center"
                                   android:paddingTop="@dimen/_5dp"
                                   android:paddingBottom="@dimen/_5dp"
                                   android:text="@string/clear_all"
                                   android:textColor="@color/white"
                                   android:textSize="@dimen/_12sp"
                                   android:textStyle="bold" />

                           </androidx.cardview.widget.CardView>


                       </LinearLayout>

                       <androidx.recyclerview.widget.RecyclerView
                           android:id="@+id/outletRecycler"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:layout_marginStart="@dimen/_5dp"
                           android:layout_marginEnd="@dimen/_5dp"
                           android:nestedScrollingEnabled="false"
                           android:orientation="vertical"
                           app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                           app:layout_constraintTop_toBottomOf="@+id/actionLl" />

                   </androidx.constraintlayout.widget.ConstraintLayout>


               </androidx.cardview.widget.CardView>


           </LinearLayout>

       </androidx.core.widget.NestedScrollView>


   </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/saveAndAddCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="5dp"
        app:cardElevation="@dimen/_3dp"
        app:cardUseCompatPadding="true">


        <androidx.cardview.widget.CardView
            android:id="@+id/saveAndShareInnerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10dp"
            android:visibility="visible"
            app:cardBackgroundColor="@color/new_blue"
            app:cardCornerRadius="@dimen/_5dp"
            app:cardElevation="@dimen/_5dp">


            <TextView
                android:id="@+id/saveAndShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:padding="@dimen/_10dp"
                android:text="@string/save_and_add"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sp" />

        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>

</RelativeLayout>