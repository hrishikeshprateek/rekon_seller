<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Reckon API is served over plain HTTP, so cleartext must be
         permitted for its domain (covers mobileappsandbox.reckonsales.com). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">reckonsales.com</domain>
    </domain-config>
</network-security-config>
